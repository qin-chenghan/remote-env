   102	check_gpu_memory() {
   103	    local gpu free_mib
   104	    local -a gpus=()
   105	    IFS=',' read -r -a gpus <<< "$GPU_LIST"
   106	    if ! command -v ixsmi >/dev/null; then log 'WARNING: ixsmi 不可用，跳过显存预检'; return; fi
   107	    for gpu in "${gpus[@]}"; do
   108	        free_mib=$(ixsmi --query-gpu=memory.free --format=csv,noheader,nounits -i "$gpu" 2>/dev/null | tr -d ' ')
   109	        if [[ "$free_mib" =~ ^[0-9]+$ ]]; then
   110	            log "GPU $gpu: free=${free_mib} MiB（原预检阈值 20480 MiB）"
   111	            (( free_mib >= 20480 )) || log "WARNING: GPU $gpu 显存偏低，请确认测试卡已预留"
   112	        else log "WARNING: 无法读取 GPU $gpu 显存"; fi
   113	    done
   114	    return 0
   115	}
   116	wait_for_server() {
   117	    local elapsed=0 code
   118	    while (( elapsed < 600 )); do
   119	        kill -0 "$SERVER_PID" 2>/dev/null || { log "ERROR: 服务已退出，查看 $SERVER_LOG"; return 1; }
   120	        code=$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:${PORT}/health" 2>/dev/null || true)
   121	        [[ "$code" == 200 ]] && { log "服务就绪 (${elapsed}s)"; return 0; }
   122	        sleep 5; elapsed=$((elapsed+5))
   123	    done
   124	    log 'ERROR: 服务启动超时'; return 1
   125	}
   126	start_server() {
   127	    # Refuse an occupied port. Never kill an unrelated service by name/port.
   128	    "${CLEAN_ENV[@]}" "$PYTHON_BIN" - "$PORT" <<'PY' || return 1
   129	import socket,sys
