     1	# Adapted from the uploaded vllmBench_lite.sh. Keep one server for all cases.
     2	#!/usr/bin/env bash
     3	# Defaults retained: warmups=16, cache OFF, CPUs 80-159,240-319, backend=vllm.
     4	# Requires the matching files in this slim folder (included in the ZIP).
     5	set -uo pipefail
     6	
     7	: "${MODEL_PATH:?ERROR: 必须设置 MODEL_PATH}"
