   134	    if [[ "$HOST_MEASURE" == lite ]]; then
   135	        env_args+=(PYTHONPATH="${HOST_TOOLKIT}${PYTHONPATH:+:$PYTHONPATH}" LD_PRELOAD="$HOST_TOOLKIT/liblitehost.so"
