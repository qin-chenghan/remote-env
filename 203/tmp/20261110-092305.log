   140	    SERVER_PID=$!; echo "$SERVER_PID" > "$PID_FILE"
   141	    log "服务 PID=$SERVER_PID；所有 case 复用；日志=$SERVER_LOG"
   142	    wait_for_server
   143	}
   144	run_case() {
   145	    local input_len="$1" output_len="$2"
   146	    local case_id="bs${MAX_CONCURRENCY}_in${input_len}_out${output_len}"
   147	    local case_log="${LOG_DIR}/bench_${case_id}.log" case_dir="${RUN_DIR}/litehost/${case_id}"
   148	    local -a client env_args
   149	    env_args=()
   150	    if [[ "$HOST_MEASURE" == lite ]]; then
   151	        "${CLEAN_ENV[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/lhctl.py" prepare --session "$SESSION_FILE" \
   152	            --case-id "$case_id" --num-prompts "$NUM_PROMPTS" --input-len "$input_len" --output-len "$output_len" || return 1
   153	        client=("$HOST_TOOLKIT/bench_driver.py")
   154	        env_args=(LIGHTHOST_SESSION="$SESSION_FILE" LIGHTHOST_CASE_DIR="$case_dir")
   155	    else
   156	        client=(-m vllm.entrypoints.cli.main bench serve)
   157	    fi
   158	    log "==== $case_id | mode=$HOST_MEASURE | warmup=$NUM_WARMUPS | 同一服务 ===="
   159	    "${CLEAN_ENV[@]}" "${env_args[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/procutil.py" exec "$RUN_DIR/bench.process.json" -- \
   160	        "$PYTHON_BIN" "${client[@]}" \
   161	        --backend vllm \
   162	        --num_prompts "$NUM_PROMPTS" --num-warmups "$NUM_WARMUPS" --max-concurrency "$MAX_CONCURRENCY" \
   163	        --dataset_name random --random_input_len "$input_len" --random_output_len "$output_len" \
   164	        --host 127.0.0.1 --port "$PORT" --model "$MODEL_PATH" --trust_remote_code \
   165	        --ignore_eos --top_p 1 --top_k -1 --temperature 0 --seed 42 \
   166	        --save-result --result-dir "$RUN_DIR" --result_filename "${case_id}.json" > "$case_log" 2>&1 &
   167	    BENCH_PID=$!
   168	    local rc=0
   169	    wait "$BENCH_PID" || rc=$?
   170	    BENCH_PID=""
   171	    if (( rc != 0 )); then log "ERROR: case 失败 rc=$rc；查看 $case_log"; return "$rc"; fi
   172	    if [[ "$HOST_MEASURE" == lite ]]; then
   173	        "${CLEAN_ENV[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/lhctl.py" finish "$case_dir" \
