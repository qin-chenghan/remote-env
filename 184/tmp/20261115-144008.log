    12	def patch_tree(source):
    13	    tree=ast.parse(textwrap.dedent(source));fn=tree.body[0]
    14	    if len(tree.body)!=1 or not isinstance(fn,ast.AsyncFunctionDef) or fn.name!='benchmark' or fn.decorator_list:raise ValueError('Unsupported benchmark function')
    15	    def assigned(s,n):return isinstance(s,ast.Assign) and len(s.targets)==1 and isinstance(s.targets[0],ast.Name) and s.targets[0].id==n
    16	    starts=[i for i,s in enumerate(fn.body) if assigned(s,'benchmark_start_time')]
    17	    ends=[i for i,s in enumerate(fn.body) if assigned(s,'benchmark_duration')]
    18	    if len(starts)!=1 or len(ends)!=1 or starts[0]>=ends[0]:raise ValueError('Unknown benchmark timer layout')
    19	    a,b=starts[0],ends[0]
    20	    if ast.unparse(fn.body[a].value)!='time.perf_counter()' or ast.unparse(fn.body[b].value)!='time.perf_counter() - benchmark_start_time':raise ValueError('Timer expressions changed')
    21	    warm=[i for i,s in enumerate(fn.body) if isinstance(s,ast.If) and 'num_warmups' in ast.unparse(s.test)]
    22	    if len(warm)!=1 or warm[0]>=a or 'asyncio.gather' not in ast.unparse(fn.body[warm[0]]):raise ValueError('Warmup ordering changed')
    23	    test=[s for s in ast.walk(fn) if assigned(s,'test_input')]
    24	    if len(test)!=1 or not isinstance(test[0].value,ast.Call) or any(k.arg=='request_id' for k in test[0].value.keywords):raise ValueError('Warmup request ID forwarding changed')
    25	    mid='\n'.join(ast.unparse(s) for s in fn.body[a:b])
    26	    if 'request.request_id' not in mid or 'request_id=request_id' not in mid or 'await asyncio.gather(*tasks)' not in mid:raise ValueError('Formal request loop changed')
    27	    body=[]
    28	    for i,s in enumerate(fn.body):
    29	        if i==a:body.extend(ast.parse('await __lh_start()').body)
    30	        body.append(s)
    31	        if i==b:body.extend(ast.parse('await __lh_end(outputs, benchmark_duration)').body)
    32	    fn.body=body;fn.name='__lh_benchmark';return ast.fix_missing_locations(tree)
    33	
    34	class Boundaries:
    35	    def __init__(self,session_file,case_dir):
    36	        self.session=read_json(session_file);self.root=Path(case_dir);self.case=read_json(self.root/'case.json')
    37	        if self.case['session_id']!=self.session['session_id']:raise ValueError('Case/session mismatch')
    38	        self.window={'status':'preparing','run_id':self.case['run_id'],'case_id':self.case['case_id'],'session_id':self.case['session_id']}
    39	        self.calls=0;self.ended=False
    40	    def save(self):atomic_json(self.root/'window.json',self.window)
    41	    async def start(self):
    42	        self.window['arm_acks']=await asyncio.to_thread(all_ranks,self.session,'arm',run_id=self.case['run_id'])
    43	        self.window.update(status='armed',main_start_ns=time.monotonic_ns());self.save()
    44	        print('[litehost] 4 ranks ARMED; all ready-check/warmup scopes excluded',flush=True)
    45	    async def end(self,outputs,duration):
    46	        self.window.update(main_end_ns=time.monotonic_ns(),benchmark_duration_s=duration,successful=sum(bool(o.success) for o in outputs),failed=sum(not bool(o.success) for o in outputs))
    47	        if len(outputs)!=self.case['expected_requests'] or not all(o.success for o in outputs):
    48	            self.window['failed_errors']=[{'i':i,'error':str(getattr(o,'error',''))[:300]} for i,o in enumerate(outputs) if not o.success][:10]
    49	            self.save()
    50	            raise RuntimeError('Formal requests incomplete/failed; no valid H')
    51	        self.window['finalize_acks']=await asyncio.to_thread(all_ranks,self.session,'finalize',run_id=self.case['run_id'])
    52	        self.window['status']='finalized';self.ended=True;self.save()
    53	        print('[litehost] 4 ranks FINALIZED; data saved; same server ready for next case',flush=True)
    54	
    55	def install(module,b):
    56	    original=module.benchmark;src=inspect.getsource(original);tree=patch_tree(src)
    57	    ns=module.__dict__;ns['__lh_start']=b.start;ns['__lh_end']=b.end
    58	    exec(compile(tree,inspect.getsourcefile(original) or '<bench>','exec'),ns)
    59	    patched=ns['__lh_benchmark'];sig=inspect.signature(original)
    60	    b.window['benchmark_source_sha256']=hashlib.sha256(src.encode()).hexdigest()
    61	    (b.root/'benchmark_hooked.py.txt').write_text(ast.unparse(tree)+'\n')
    62	    @wraps(original)
    63	    async def wrapped(*args,**kwargs):
    64	        b.calls+=1
    65	        if b.calls!=1:raise ValueError('One benchmark call per client process required')
    66	        bind=sig.bind(*args,**kwargs);bind.apply_defaults()
    67	        if bind.arguments.get('profile'):raise ValueError('Torch profiler must be disabled')
    68	        if bind.arguments.get('endpoint_type') not in ('vllm','openai'):raise ValueError('Only original text completions backend supported')
    69	        requests=list(bind.arguments['input_requests'])
    70	        if len(requests)!=b.case['expected_requests']:raise ValueError('Request count mismatch')
    71	        new=[]
    72	        for i,r in enumerate(requests):
    73	            if not is_dataclass(r) or not isinstance(r.prompt,str):raise ValueError('Expected text SampleRequest dataclass')
    74	            if any(getattr(r,k,None) for k in ('multi_modal_data','chat_messages','request_overrides')):raise ValueError('Multimodal/chat/overrides unsupported')
    75	            new.append(replace(r,request_id='lh'+b.case['run_id']+'-'+str(i)))
    76	        bind.arguments['input_requests']=new
    77	        b.window['num_warmups']=bind.arguments.get('num_warmups');b.save()
    78	        return await patched(*bind.args,**bind.kwargs)
    79	    module.benchmark=wrapped
    80	
    81	def main():
    82	    b=Boundaries(os.environ['LIGHTHOST_SESSION'],os.environ['LIGHTHOST_CASE_DIR'])
    83	    try:
    84	        import vllm.benchmarks.serve as module
    85	        install(module,b);sys.argv=['vllm','bench','serve',*sys.argv[1:]]
    86	        try:runpy.run_module('vllm.entrypoints.cli.main',run_name='__main__');rc=0
    87	        except SystemExit as e:rc=int(e.code or 0)
    88	        if rc or b.calls!=1 or not b.ended:raise RuntimeError(f'Client incomplete: rc={rc},calls={b.calls},ended={b.ended}')
    89	        b.window['status']='complete';b.save();return 0
    90	    except BaseException as e:
    91	        b.window.update(status='failed',error=f'{type(e).__name__}: {e}');b.save()
    92	        __import__('traceback').print_exc();return 2
    93	if __name__=='__main__':raise SystemExit(main())
