     1	#!/usr/bin/env python3
     2	"""Same installed vLLM client/CLI/parameters; only instrument formal boundaries.
     3	Official warmups remain unchanged. Does not modify installed source files.
     4	"""
     5	from __future__ import annotations
     6	import ast,asyncio,inspect,os,runpy,sys,textwrap,time,hashlib
     7	from dataclasses import replace,is_dataclass
     8	from pathlib import Path
     9	from functools import wraps
    10	from lh_common import atomic_json,read_json,all_ranks
