     1	#!/usr/bin/env bash
     2	# Adapted from the uploaded vllmBench_lite.sh. Keep one server for all cases.
     3	# Defaults retained: warmups=16, cache OFF, CPUs 192-255 (NUMA node 3), backend=vllm.
