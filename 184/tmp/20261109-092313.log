    41	
    42	BASE_DIR="$(pwd)"
    43	RUN_DIR="${BASE_DIR}/vllmBench/${TEST_ID}"
    44	LOG_DIR="${RUN_DIR}/logs"
    45	SERVER_LOG="${LOG_DIR}/server.log"
    46	SUMMARY_CSV="${RUN_DIR}/summary.csv"
