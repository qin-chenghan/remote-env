    48	PID_FILE="${RUN_DIR}/server.pid"
    49	SERVER_PID=""; BENCH_PID=""; CLEANED=0; INIT_DONE=0; PGO_RESTORE=0
    50	
    51	# Original case matrix: only 128/128 enabled; uncomment the others as before.
