    21	HOST_TIMEOUT="${HOST_TIMEOUT:-120}"
    22	HOST_MAX_SCOPES="${HOST_MAX_SCOPES:-200000}"
    23	HOST_DRY_RUN="${HOST_DRY_RUN:-0}"
    24	SERVER_EXTRA_ENV=(
    25	    UMD_MAXCOMMANDBUFFERNUMBER=256
    26	    UMD_MAXCOMMANDBUFFERSIZE=16384
    27	    VLLM_HOST_FASTPATH=on
    28	    TORCH_MODULE_ATTR_FASTPATH=slot_native
    29	)
    30	SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    31	# Do not use an inherited OLD LIGHTHOST_HOME silently.
    32	if [[ -f "$SCRIPT_DIR/lhctl.py" ]]; then
    33	    HOST_TOOLKIT="${HOST_TOOLKIT:-$SCRIPT_DIR}"
    34	else
    35	    HOST_TOOLKIT="${HOST_TOOLKIT:-$SCRIPT_DIR/litehost_compat_slim}"
    36	fi
    37	HOST_TOOLKIT="$(cd -- "$HOST_TOOLKIT" 2>/dev/null && pwd)" || { echo 'ERROR: 解压完整 litehost_compat_slim_v041.zip 或设置 HOST_TOOLKIT' >&2; exit 2; }
    38	[[ -x "$PYTHON_BIN" && -f "$HOST_TOOLKIT/lhctl.py" ]] || { echo 'ERROR: Python 或配套文件缺失' >&2; exit 2; }
    39	[[ "$HOST_MEASURE" == lite || "$HOST_MEASURE" == off ]] || { echo 'ERROR: HOST_MEASURE=lite|off' >&2; exit 2; }
    40	[[ "$GPUS_PER_INSTANCE" == 4 ]] || { echo 'ERROR: 此版要求四卡 TP=4, PP=1, DP=1' >&2; exit 2; }
    41	[[ "$TEST_ID" =~ ^[A-Za-z0-9_.-]+$ && "$TEST_ID" != . && "$TEST_ID" != .. ]] || { echo 'ERROR: TEST_ID 不能包含路径分隔符' >&2; exit 2; }
    42	
    43	BASE_DIR="$(pwd)"
    44	RUN_DIR="${BASE_DIR}/vllmBench/${TEST_ID}"
    45	LOG_DIR="${RUN_DIR}/logs"
    46	SERVER_LOG="${LOG_DIR}/server.log"
    47	SUMMARY_CSV="${RUN_DIR}/summary.csv"
    48	SESSION_FILE="${RUN_DIR}/session.json"
    49	PID_FILE="${RUN_DIR}/server.pid"
    50	SERVER_PID=""; BENCH_PID=""; CLEANED=0; INIT_DONE=0; PGO_RESTORE=0
    51	
    52	# Original case matrix: only 128/128 enabled; uncomment the others as before.
    53	CASES=(
    54	  "128 128"
    55	  "128 1024"
    56	  "128 2048"
    57	  "1024 128"
    58	  "1024 1024"
    59	  "1024 2048"
    60	  "2048 128"
    61	  "2048 1024"
    62	  "2048 2048"
    63	)
    64	# Optional text file, one 'input output' case per nonblank/non-comment line.
