    69	log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
    70	# Child processes only: drop old measurement/audit injection; keep CoreX library paths.
    71	CLEAN_ENV=(env -u LD_PRELOAD -u LD_AUDIT -u LD_DEBUG -u LD_DEBUG_OUTPUT -u LD_BIND_NOT
    72	    -u LD_PROFILE -u VLLM_TORCH_PROFILER_DIR -u PROFILER_CONFIG -u TORCH_PROFILER_DIR)
    73	# ---- PGO guard: autofix two known-safe block causes, verify rollback --------
    74	PGO_VENV=/opt/corex311
    75	PGO_STATE=/root/.local/state/cpython-vllm-rebase
    76	
    77	pgo_runtime() {
    78	    "${CLEAN_ENV[@]}" -u PYTHONPATH -u PYTHONHOME "$PYTHON_BIN" -c \
    79	        'import sysconfig; print(sysconfig.get_config_var("CONFIG_ARGS") or "")' 2>/dev/null || true
    80	}
    81	
    82	pgo_is_on() {
    83	    local args
    84	    args=$(pgo_runtime)
    85	    [[ "$args" == *"--prefix=/opt/cpython-vllm/v1"* && "$args" == *"--with-lto"* ]]
    86	}
    87	
    88	pgo_fix_perms() {
    89	    local dir mode
    90	    for dir in "$PGO_VENV" "$PGO_VENV/bin" "$PGO_VENV/lib" "$PGO_VENV/lib/python3.11" \
    91	               "$PGO_VENV/lib/python3.11/site-packages"; do
    92	        [[ -d "$dir" ]] || continue
    93	        mode=$(stat -c %a "$dir" 2>/dev/null) || continue
    94	        if (( (8#$mode & 8#022) != 0 )); then
    95	            chmod g-w,o-w "$dir" && log "autofix: chmod g-w,o-w $dir"
    96	        fi
    97	    done
    98	}
    99	
   100	pgo_fix_index() {
   101	    local idx
   102	    idx=$(ls -1 "$PGO_STATE"/venv-*.json 2>/dev/null | head -1)
   103	    [[ -n "$idx" ]] || { log "autofix: 未找到索引文件，跳过"; return 1; }
   104	    mv -- "$idx" "$idx.stale-$(date +%Y%m%d_%H%M%S)" \
   105	        && log "autofix: 旧索引已挪开 -> $(basename "$idx").stale-*"
   106	}
   107	
   108	# Only called when the venv is NOT already on PGO. Retries once after a
   109	# known-safe autofix; anything else is reported unchanged to the caller.
   110	pgo_switch() {
   111	    local out rc
   112	    out=$(env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
   113	        cpython-vllm-rebase switch --venv "$PGO_VENV" --ack-services-stopped 2>&1); rc=$?
   114	    if (( rc == 0 )); then
   115	        printf '%s\n' "$out"
   116	        return 0
   117	    fi
   118	    log "rebase switch 失败: $(printf '%s' "$out" | tr '\n' ' ' | tail -c 220)"
   119	    case "$out" in
   120	        *VENV_DIRECTORY_GROUP_OR_WORLD_WRITABLE*)
   121	            log "autofix: venv 目录带组/其他用户写权限，修正后重试"
   122	            pgo_fix_perms ;;
   123	        *PACKAGE_METADATA_CHANGED*)
   124	            log "autofix: 包清单与旧事务记录不一致，挪开索引后重试"
   125	            pgo_fix_index || return "$rc" ;;
   126	        *)
   127	            return "$rc" ;;
   128	    esac
   129	    env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
   130	        cpython-vllm-rebase switch --venv "$PGO_VENV" --ack-services-stopped
   131	}
   132	
   133	# Rollback; if the index record is gone, fall back to the newest APPLIED
   134	# transaction (this is the NO_MANAGED_TRANSACTION_... case).
   135	pgo_rollback() {
   136	    local out rc txn
   137	    out=$(env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
   138	        cpython-vllm-rebase rollback --venv "$PGO_VENV" --ack-services-stopped 2>&1); rc=$?
   139	    if (( rc == 0 )); then
   140	        printf '%s\n' "$out"
   141	        return 0
   142	    fi
   143	    log "rebase rollback 失败: $(printf '%s' "$out" | tr '\n' ' ' | tail -c 220)"
   144	    if [[ "$out" == *NO_MANAGED_TRANSACTION* ]]; then
   145	        txn=$(grep -l '"APPLIED_VERIFIED"' "$PGO_STATE"/20*/state.json 2>/dev/null \
   146	              | sed 's|/state.json$||' | sort | tail -1)
   147	        if [[ -n "$txn" ]]; then
   148	            log "autofix: 索引缺失，改用 --transaction $(basename "$txn")"
   149	            env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
   150	                cpython-vllm-rebase rollback --transaction "$txn" --ack-services-stopped
   151	            return $?
   152	        fi
   153	        log "autofix: 未找到可回滚的 APPLIED 事务"
   154	    fi
   155	    return "$rc"
   156	}
   157	
   158	SERVER_PREFIX=()
   159	[[ -n "$CPU_RANGE" ]] && SERVER_PREFIX=(taskset -c "$CPU_RANGE")
   160	SERVER_ARGS=(
   161	    -m vllm.entrypoints.openai.api_server
   162	    --host 127.0.0.1 --port "$PORT" --model "$MODEL_PATH" --trust_remote_code --dtype auto
   163	    --max_model_len 4096 --distributed_executor_backend mp --pipeline_parallel_size 1
   164	    --tensor_parallel_size "$GPUS_PER_INSTANCE" --data_parallel_size 1
   165	    --quantization compressed-tensors --gpu_memory_utilization 0.9 --kv_cache_dtype auto
   166	    --enable_chunked_prefill --compilation-config '{"cudagraph_mode":"FULL_DECODE_ONLY", "mode":0}'
   167	    --async-scheduling --no-enable-prefix-caching
   168	)
   169	[[ "$HOST_MEASURE" == lite ]] && SERVER_ARGS+=(--worker-cls light_host_worker.LightHostWorker)
   170	
   171	cleanup() {
   172	    if [[ "$CLEANED" == 1 ]]; then return; fi
   173	    CLEANED=1
   174	    if [[ -n "$BENCH_PID" ]]; then
   175	        "${CLEAN_ENV[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/procutil.py" stop "$RUN_DIR/bench.process.json" || true
   176	        wait "$BENCH_PID" 2>/dev/null || true
   177	        BENCH_PID=""
   178	    fi
   179	    if [[ -n "$SERVER_PID" ]]; then
   180	        log "停止本次服务 PID=$SERVER_PID（不使用全局 pkill）"
   181	        "${CLEAN_ENV[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/procutil.py" stop "$RUN_DIR/server.process.json" || true
   182	        wait "$SERVER_PID" 2>/dev/null || true
   183	        SERVER_PID=""; rm -f -- "$PID_FILE"
   184	    fi
   185	    if [[ "$INIT_DONE" == 1 ]]; then
   186	        "${CLEAN_ENV[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/lhctl.py" cleanup-control --session "$SESSION_FILE" || true
   187	    fi
   188	    if [[ "$PGO_RESTORE" == 1 ]]; then
   189	        log "回滚 $PGO_VENV 到原 base"
   190	        if pgo_rollback; then
   191	            :
   192	        elif pgo_is_on; then
   193	            log "WARNING: rollback 未完成，venv 仍停在 PGO"
   194	            log "         下一步: /opt/corex311/bin/python3 /home/qch/scripts/pgo-doctor.py off"
   195	            [[ -d "$RUN_DIR" ]] && date > "$RUN_DIR/PGO_ROLLBACK_FAILED.txt"
   196	        else
   197	            log "NOTE: rollback 报校验提示，但运行时已回到 base（已知的 payload 变更情况，无需处理）"
   198	        fi
   199	        PGO_RESTORE=0
   200	    fi
   201	}
   202	trap cleanup EXIT
   203	trap 'exit 130' INT
   204	trap 'exit 143' TERM
   205	
   206	if pgo_is_on; then
   207	    log "PGO 运行时已启用，跳过 switch"
   208	else
   209	    if pgo_switch; then
   210	        PGO_RESTORE=1
   211	        log "已切换到 PGO 运行时（结束时回滚）"
   212	    else
   213	        log "ERROR: rebase switch 失败，无法保证在 PGO 环境运行"
   214	        log "       诊断: /opt/corex311/bin/python3 /home/qch/scripts/pgo-doctor.py"
   215	        exit 3
   216	    fi
   217	fi
   218	
   219	check_gpu_memory() {
   220	    local gpu free_mib
   221	    local -a gpus=()
   222	    IFS=',' read -r -a gpus <<< "$GPU_LIST"
   223	    if ! command -v ixsmi >/dev/null; then log 'WARNING: ixsmi 不可用，跳过显存预检'; return; fi
   224	    for gpu in "${gpus[@]}"; do
   225	        free_mib=$(ixsmi --query-gpu=memory.free --format=csv,noheader,nounits -i "$gpu" 2>/dev/null | tr -d ' ')
   226	        if [[ "$free_mib" =~ ^[0-9]+$ ]]; then
   227	            log "GPU $gpu: free=${free_mib} MiB（原预检阈值 20480 MiB）"
   228	            (( free_mib >= 20480 )) || log "WARNING: GPU $gpu 显存偏低，请确认测试卡已预留"
   229	        else log "WARNING: 无法读取 GPU $gpu 显存"; fi
   230	    done
   231	    return 0
   232	}
   233	wait_for_server() {
   234	    local elapsed=0 code
   235	    while (( elapsed < 600 )); do
   236	        kill -0 "$SERVER_PID" 2>/dev/null || { log "ERROR: 服务已退出，查看 $SERVER_LOG"; return 1; }
   237	        code=$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:${PORT}/health" 2>/dev/null || true)
   238	        [[ "$code" == 200 ]] && { log "服务就绪 (${elapsed}s)"; return 0; }
   239	        sleep 5; elapsed=$((elapsed+5))
   240	    done
   241	    log 'ERROR: 服务启动超时'; return 1
   242	}
   243	start_server() {
   244	    # Refuse an occupied port. Never kill an unrelated service by name/port.
   245	    "${CLEAN_ENV[@]}" "$PYTHON_BIN" - "$PORT" <<'PY' || return 1
   246	import socket,sys
   247	with socket.socket() as s:s.bind(('127.0.0.1',int(sys.argv[1])))
   248	PY
   249	    check_gpu_memory "$GPU_LIST"
   250	    local -a env_args=(CUDA_VISIBLE_DEVICES="$GPU_LIST" VLLM_ENFORCE_CUDA_GRAPH=1 VLLM_USE_V1=1
   251	        "${SERVER_EXTRA_ENV[@]}")
   252	    if [[ "$HOST_MEASURE" == lite ]]; then
   253	        env_args+=(PYTHONPATH="${HOST_TOOLKIT}${PYTHONPATH:+:$PYTHONPATH}"
   254	            LD_PRELOAD="$HOST_TOOLKIT/liblitehost.so:/home/huawei_ts_program/gperftools/.libs/libtcmalloc.so"
   255	            TCMALLOC_MAX_TOTAL_THREAD_CACHE_BYTES=536870912
   256	            MALLOCSTATS=1
   257	            LIGHTHOST_LIB="$HOST_TOOLKIT/liblitehost.so" LIGHTHOST_SESSION="$SESSION_FILE")
   258	    fi
   259	    "${CLEAN_ENV[@]}" "${env_args[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/procutil.py" exec "$RUN_DIR/server.process.json" -- \
   260	        "${SERVER_PREFIX[@]}" "$PYTHON_BIN" "${SERVER_ARGS[@]}" >> "$SERVER_LOG" 2>&1 &
   261	    SERVER_PID=$!; echo "$SERVER_PID" > "$PID_FILE"
   262	    log "服务 PID=$SERVER_PID；所有 case 复用；日志=$SERVER_LOG"
   263	    wait_for_server
   264	}
   265	run_case() {
   266	    local input_len="$1" output_len="$2"
   267	    local case_id="bs${MAX_CONCURRENCY}_in${input_len}_out${output_len}"
   268	    local case_log="${LOG_DIR}/bench_${case_id}.log" case_dir="${RUN_DIR}/litehost/${case_id}"
   269	    local -a client env_args
   270	    env_args=()
   271	    if [[ "$HOST_MEASURE" == lite ]]; then
   272	        "${CLEAN_ENV[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/lhctl.py" prepare --session "$SESSION_FILE" \
   273	            --case-id "$case_id" --num-prompts "$NUM_PROMPTS" --input-len "$input_len" --output-len "$output_len" || return 1
   274	        client=("$HOST_TOOLKIT/bench_driver.py")
   275	        env_args=(LIGHTHOST_SESSION="$SESSION_FILE" LIGHTHOST_CASE_DIR="$case_dir")
   276	    else
   277	        client=(-m vllm.entrypoints.cli.main bench serve)
   278	    fi
   279	    log "==== $case_id | mode=$HOST_MEASURE | warmup=$NUM_WARMUPS | 同一服务 ===="
   280	    "${CLEAN_ENV[@]}" "${env_args[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/procutil.py" exec "$RUN_DIR/bench.process.json" -- \
   281	        "$PYTHON_BIN" "${client[@]}" \
   282	        --backend vllm \
   283	        --num_prompts "$NUM_PROMPTS" --num-warmups "$NUM_WARMUPS" --max-concurrency "$MAX_CONCURRENCY" \
   284	        --dataset_name random --random_input_len "$input_len" --random_output_len "$output_len" \
   285	        --host 127.0.0.1 --port "$PORT" --model "$MODEL_PATH" --trust_remote_code \
   286	        --ignore_eos --top_p 1 --top_k -1 --temperature 0 --seed 42 \
   287	        --save-result --result-dir "$RUN_DIR" --result_filename "${case_id}.json" > "$case_log" 2>&1 &
   288	    BENCH_PID=$!
   289	    local rc=0
   290	    wait "$BENCH_PID" || rc=$?
   291	    BENCH_PID=""
   292	    if (( rc != 0 )); then log "ERROR: case 失败 rc=$rc；查看 $case_log"; return "$rc"; fi
   293	    if [[ "$HOST_MEASURE" == lite ]]; then
   294	        "${CLEAN_ENV[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/lhctl.py" finish "$case_dir" \
   295	            --link-percent "$HOST_LINK_PERCENT" || return 1
   296	    fi
   297	    log "完成 $case_id → ${RUN_DIR}/${case_id}.json"
   298	}
   299	
   300	# Validate cheap inputs before model initialization.
   301	"${CLEAN_ENV[@]}" "$PYTHON_BIN" - "$GPU_LIST" "$NUM_PROMPTS" "$NUM_WARMUPS" "$MAX_CONCURRENCY" "$HOST_LINK_PERCENT" "$CASE_INTERVAL" "${CASES[@]}" <<'PY' || exit 2
   302	import math,sys
   303	ids,n,w,c,p,interval,*cases=sys.argv[1:]
   304	if len(ids.split(','))!=4 or len(set(ids.split(',')))!=4:raise ValueError('需要四张不同 GPU')
   305	if int(n)<=0 or int(w)<0 or int(c)<=0:raise ValueError('请求/预热/并发参数无效')
   306	if not math.isfinite(float(p)) or not 0<=float(p)<=100 or float(interval)<0:raise ValueError('系数或间隔无效')
   307	if not cases or len(cases)!=len(set(cases)):raise ValueError('case 列表为空或重复')
   308	for x in cases:
   309	    parts=x.split()
   310	    if len(parts)!=2 or min(map(int,parts))<=0 or sum(map(int,parts))>4096:raise ValueError('case 需要两个正整数且总长 <= 4096')
   311	PY
   312	log "TEST_ID=$TEST_ID | MODE=$HOST_MEASURE | WARMUP=$NUM_WARMUPS | CPU_RANGE=$CPU_RANGE"
   313	log "prefix cache=OFF | backend=vllm | 同一服务运行 ${#CASES[@]} 个 case | RUN_DIR=$RUN_DIR"
   314	if [[ "$HOST_DRY_RUN" == 1 ]]; then
   315	    printf 'SERVER: '; printf '%q ' "${SERVER_PREFIX[@]}" "$PYTHON_BIN" "${SERVER_ARGS[@]}"; printf '\n'
   316	    printf 'CASES: '; printf '%s; ' "${CASES[@]}"; printf '\n'
   317	    exit 0
   318	fi
   319	[[ -d "$MODEL_PATH" ]] || { log 'ERROR: MODEL_PATH 不是本地目录'; exit 2; }
   320	if [[ -e "$RUN_DIR" ]]; then log 'ERROR: RUN_DIR 已存在，请换一个 TEST_ID，避免混入旧文件'; exit 2; fi
   321	mkdir -p "$LOG_DIR"
   322	{
   323	    echo "test_id=$TEST_ID"
   324	    echo "started=$(date -Is)"
   325	    echo "pgo=$(pgo_is_on && echo on || echo off)"
   326	    echo "multi_engine=$(cat /sys/module/iluvatar/parameters/itr_multi_compute_engine 2>/dev/null || echo unknown)"
   327	    echo "cpu_range=$CPU_RANGE"
   328	    echo "hotspot_opt=${HOTSPOT_OPT:-unset}"
   329	    echo "model_path=$MODEL_PATH"
   330	    echo "gpus=$GPU_LIST tp=$GPUS_PER_INSTANCE"
   331	    echo "prompts=$NUM_PROMPTS concurrency=$MAX_CONCURRENCY warmups=$NUM_WARMUPS"
   332	} > "$RUN_DIR/config.txt" 2>/dev/null || true
   333	if [[ "$HOST_MEASURE" == lite ]]; then
   334	    "${CLEAN_ENV[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/lhctl.py" init --run-dir "$RUN_DIR" \
   335	        --timeout "$HOST_TIMEOUT" --max-scopes "$HOST_MAX_SCOPES" > "$LOG_DIR/preflight.log" 2>&1 || { cat "$LOG_DIR/preflight.log"; exit 2; }
   336	    INIT_DONE=1
   337	fi
   338	if ! start_server; then log 'FATAL: 启动失败'; exit 1; fi
   339	FAILED=0
   340	for idx in "${!CASES[@]}"; do
   341	    read -r input_len output_len <<< "${CASES[$idx]}"
   342	    if ! run_case "$input_len" "$output_len"; then
   343	        FAILED=1; log '停止后续 case，避免未完成请求或测量状态污染下一轮'; break
   344	    fi
   345	    if (( idx < ${#CASES[@]}-1 )); then log "等待 ${CASE_INTERVAL}s"; sleep "$CASE_INTERVAL"; fi
   346	done
   347	# Intermediate case results have already been validated and saved by
   348	# lhctl.py finish (quietly). Build all-case CSV + Host report SILENTLY;
   349	# print both result summaries only ONCE, after all cases and server cleanup.
   350	if ! "${CLEAN_ENV[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/lhctl.py" summary "$RUN_DIR" \
   351	        > "$LOG_DIR/summary_build.log"; then
   352	    FAILED=1
   353	fi
   354	if [[ "$HOST_MEASURE" == lite && "$FAILED" == 0 ]]; then
   355	    "${CLEAN_ENV[@]}" "$PYTHON_BIN" "$HOST_TOOLKIT/analyze_litehost.py" "$RUN_DIR/litehost" \
   356	        --link-percent "$HOST_LINK_PERCENT" --out "$RUN_DIR/host_summary" --quiet || FAILED=1
   357	fi
   358	cleanup
   359	(( FAILED == 0 )) || { log "部分失败，保留诊断：$RUN_DIR"; exit 2; }
   360	
   361	log "========== 所有 case 最终结果（仅此处打印一次） =========="
   362	"${CLEAN_ENV[@]}" "$PYTHON_BIN" - "$SUMMARY_CSV" "$MAX_CONCURRENCY" "${CASES[@]}" <<'PY' || exit 2
   363	import csv,sys
   364	from pathlib import Path
   365	path=Path(sys.argv[1]);bs=sys.argv[2]
   366	with path.open(newline='') as f:
   367	    rows={r['case']:r for r in csv.DictReader(f)}
   368	print('===== Benchmark：吞吐与延迟（全部 case）=====')
   369	for spec in sys.argv[3:]:
   370	    in_len,out_len=spec.split()
   371	    case=f'bs{bs}_in{in_len}_out{out_len}'
   372	    if case not in rows:raise SystemExit(f'ERROR: summary.csv 缺少 {case}')
   373	    r=rows[case]
   374	    def fmt(key):
   375	        val=r.get(key,'')
   376	        try:return f'{float(val):.3f}'
   377	        except (TypeError,ValueError):return 'N/A'
   378	    print(f'{case}: output_tok/s={fmt("output_token_throughput_tok_s")} '
   379	          f'TTFT_mean={fmt("mean_ttft_ms")}ms '
   380	          f'TPOT_mean={fmt("mean_tpot_ms")}ms ITL_mean={fmt("mean_itl_ms")}ms')
   381	PY
   382	if [[ "$HOST_MEASURE" == lite ]]; then
   383	    echo '===== LiteHost：四 rank、所有 case 的 H 与 H+G ====='
   384	    cat "$RUN_DIR/host_summary/report.txt"
   385	fi
   386	log "全部完成 | benchmark=$SUMMARY_CSV | host=$([[ "$HOST_MEASURE" == lite ]] && echo "$RUN_DIR/host_summary/report.txt" || echo 'OFF/未采集')"
