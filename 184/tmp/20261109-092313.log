    68	log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
    69	# Child processes only: drop old measurement/audit injection; keep CoreX library paths.
    70	CLEAN_ENV=(env -u LD_PRELOAD -u LD_AUDIT -u LD_DEBUG -u LD_DEBUG_OUTPUT -u LD_BIND_NOT
    71	    -u LD_PROFILE -u VLLM_TORCH_PROFILER_DIR -u PROFILER_CONFIG -u TORCH_PROFILER_DIR)
    72	# ---- PGO guard: autofix two known-safe block causes, verify rollback --------
    73	PGO_VENV=/opt/corex311
    74	PGO_STATE=/root/.local/state/cpython-vllm-rebase
    75	
    76	pgo_runtime() {
    77	    "${CLEAN_ENV[@]}" -u PYTHONPATH -u PYTHONHOME "$PYTHON_BIN" -c \
    78	        'import sysconfig; print(sysconfig.get_config_var("CONFIG_ARGS") or "")' 2>/dev/null || true
    79	}
    80	
    81	pgo_is_on() {
    82	    local args
    83	    args=$(pgo_runtime)
    84	    [[ "$args" == *"--prefix=/opt/cpython-vllm/v1"* && "$args" == *"--with-lto"* ]]
    85	}
    86	
    87	pgo_fix_perms() {
    88	    local dir mode
    89	    for dir in "$PGO_VENV" "$PGO_VENV/bin" "$PGO_VENV/lib" "$PGO_VENV/lib/python3.11" \
    90	               "$PGO_VENV/lib/python3.11/site-packages"; do
    91	        [[ -d "$dir" ]] || continue
    92	        mode=$(stat -c %a "$dir" 2>/dev/null) || continue
    93	        if (( (8#$mode & 8#022) != 0 )); then
    94	            chmod g-w,o-w "$dir" && log "autofix: chmod g-w,o-w $dir"
    95	        fi
    96	    done
    97	}
    98	
    99	pgo_fix_index() {
   100	    local idx
   101	    idx=$(ls -1 "$PGO_STATE"/venv-*.json 2>/dev/null | head -1)
   102	    [[ -n "$idx" ]] || { log "autofix: 未找到索引文件，跳过"; return 1; }
   103	    mv -- "$idx" "$idx.stale-$(date +%Y%m%d_%H%M%S)" \
   104	        && log "autofix: 旧索引已挪开 -> $(basename "$idx").stale-*"
   105	}
   106	
   107	# Switch back to PGO; retries once after a known-safe autofix.
   108	pgo_switch() {
   109	    local out rc
   110	    out=$(env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
   111	        cpython-vllm-rebase switch --venv "$PGO_VENV" --ack-services-stopped 2>&1); rc=$?
   112	    if (( rc == 0 )); then
   113	        printf '%s\n' "$out"
   114	        return 0
   115	    fi
   116	    log "rebase switch 失败: $(printf '%s' "$out" | tr '\n' ' ' | tail -c 220)"
   117	    case "$out" in
   118	        *VENV_DIRECTORY_GROUP_OR_WORLD_WRITABLE*)
   119	            log "autofix: venv 目录带组/其他用户写权限，修正后重试"
   120	            pgo_fix_perms ;;
   121	        *PACKAGE_METADATA_CHANGED*)
   122	            log "autofix: 包清单与旧事务记录不一致，挪开索引后重试"
   123	            pgo_fix_index || return "$rc" ;;
   124	        *)
   125	            return "$rc" ;;
   126	    esac
   127	    env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
   128	        cpython-vllm-rebase switch --venv "$PGO_VENV" --ack-services-stopped
   129	}
   130	
   131	# Rollback; if the index record is gone, fall back to the newest APPLIED
   132	# transaction (this is the NO_MANAGED_TRANSACTION_... case).
   133	pgo_rollback() {
   134	    local out rc txn
   135	    out=$(env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
   136	        cpython-vllm-rebase rollback --venv "$PGO_VENV" --ack-services-stopped 2>&1); rc=$?
   137	    if (( rc == 0 )); then
   138	        printf '%s\n' "$out"
   139	        return 0
   140	    fi
   141	    log "rebase rollback 失败: $(printf '%s' "$out" | tr '\n' ' ' | tail -c 220)"
   142	    if [[ "$out" == *NO_MANAGED_TRANSACTION* ]]; then
   143	        txn=$(grep -l '"APPLIED_VERIFIED"' "$PGO_STATE"/20*/state.json 2>/dev/null \
   144	              | sed 's|/state.json$||' | sort | tail -1)
   145	        if [[ -n "$txn" ]]; then
   146	            log "autofix: 索引缺失，改用 --transaction $(basename "$txn")"
   147	            env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
   148	                cpython-vllm-rebase rollback --transaction "$txn" --ack-services-stopped
   149	            return $?
   150	        fi
   151	        log "autofix: 未找到可回滚的 APPLIED 事务"
   152	    fi
   153	    return "$rc"
   154	}
