   163	    --quantization compressed-tensors --gpu_memory_utilization 0.9 --kv_cache_dtype auto
   164	    --enable_chunked_prefill --compilation-config '{"cudagraph_mode":"FULL_DECODE_ONLY", "mode":0}'
   165	    --async-scheduling --no-enable-prefix-caching
