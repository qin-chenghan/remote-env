LOG_DIR="${RUN_DIR}/logs"
PROFILE_ROOT_DIR="${PROFILE_ROOT_DIR:-${RUN_DIR}/profile}"
PROFILE_DIRS="${PROFILE_DIRS:-${PROFILE_ROOT_DIR}}"
SERVER_LOG="${LOG_DIR}/server.log"
