     1	#!/usr/bin/env bash
     2	# =============================================================================
     3	# vllmBench_lite_timeline.sh - vLLM Torch timeline/profile 采集脚本(单实例版)
     4	# 部署: CoreX 容器 corex5-py311, venv=/opt/corex311, 四卡单实例 (TP=4, PP=1, DP=1)
     5	# 说明: 本文件只采集 timeline;原始 benchmark/litehost 采数逻辑已移除。
     6	# 用法:
     7	#   export MODEL_PATH=/path/to/Qwen3-32B-W8A8
     8	#   export TEST_ID=20260901_timeline
     9	#   bash ./vllmBench_lite_timeline.sh
    10	#
    11	# 必传: MODEL_PATH, TEST_ID
    12	# 可选: PYTHON_BIN / GPU_LIST / GPUS_PER_INSTANCE / PORT / NUM_PROMPTS /
    13	#       NUM_WARMUPS / MAX_CONCURRENCY / ENABLE_TASKSET_BINDING / CPU_RANGE /
    14	#       VLLM_RPC_TIMEOUT / PROFILE_EVERY / CASES_FILE
    15	# =============================================================================
    16	
    17	set -uo pipefail
    18	
    19	# ============ 必传环境变量校验 ============
    20	: "${MODEL_PATH:?ERROR: 必须设置 MODEL_PATH}"
    21	: "${TEST_ID:?ERROR: 必须设置 TEST_ID}"
    22	[[ "$TEST_ID" =~ ^[A-Za-z0-9_.-]+$ && "$TEST_ID" != . && "$TEST_ID" != .. ]] || { echo 'ERROR: TEST_ID 不能包含路径分隔符' >&2; exit 2; }
    23	
    24	# ============ 可选环境变量(带默认值)============
    25	PREFIX="${PREFIX:-/opt/corex311}"
    26	PYTHON_BIN="${PYTHON_BIN:-${PREFIX}/bin/python3}"
    27	GPU_LIST="${GPU_LIST:-0,1,2,3}"
    28	GPUS_PER_INSTANCE="${GPUS_PER_INSTANCE:-4}"
    29	PORT="${PORT:-8848}"
    30	NUM_PROMPTS="${NUM_PROMPTS:-100}"
    31	NUM_WARMUPS="${NUM_WARMUPS:-16}"
    32	MAX_CONCURRENCY="${MAX_CONCURRENCY:-8}"
    33	ENABLE_TASKSET_BINDING="${ENABLE_TASKSET_BINDING:-1}"
    34	CPU_RANGE="${CPU_RANGE:-80-159,240-319}"
    35	# profile flush 较慢,官方建议 30min
    36	VLLM_RPC_TIMEOUT="${VLLM_RPC_TIMEOUT:-1800000}"
    37	# PROFILE_EVERY=1 → 每个 case 都 profile
    38	# PROFILE_EVERY=N → 每 N 个 case profile 一次(idx=0, N, 2N, ...)
    39	PROFILE_EVERY="${PROFILE_EVERY:-1}"
    40	# 每个 case 跑完后等待的间隔(秒),给 server / worker 资源释放时间
    41	# profile case 间隔也要拉长,否则上一个 case 的 trace 还没 flush 完,影响下一个
    42	CASE_INTERVAL="${CASE_INTERVAL:-60}"
    43	
    44	# ============ 0.23 profiler schedule 参数 ============
    45	# vLLM 0.23 完全弃用 VLLM_TORCH_PROFILER_DIR 环境变量,改用 --profiler-config。
    46	# 关键点:warmup_iterations=0 时,vLLM 连续记录 /start_profile 到 /stop_profile
    47	# 之间的 worker iteration;模型预热由 bench serve 在 /start_profile 前完成。
    48	# warmup_iterations=0 时不启用一次性 schedule,由 stop_profile 结束并写出 trace。
    49	#   delay_iterations: /start_profile 后跳过前 N 步再开始 profile(prefill 阶段或编译)
    50	#   max_iterations  : profile 累计 N 步后自动 stop;0=不限,直到 /stop_profile
    51	PROFILE_DELAY_ITERATIONS="${PROFILE_DELAY_ITERATIONS:-0}"
    52	PROFILE_MAX_ITERATIONS="${PROFILE_MAX_ITERATIONS:-0}"
    53	PROFILE_WARMUP_ITERATIONS="${PROFILE_WARMUP_ITERATIONS:-0}"
    54	PROFILE_ACTIVE_ITERATIONS="${PROFILE_ACTIVE_ITERATIONS:-2000}"
    55	
    56	# ============ 目录结构 ============
    57	BASE_DIR="$(pwd)"
    58	RUN_DIR="${BASE_DIR}/timeline/${TEST_ID}"
    59	LOG_DIR="${RUN_DIR}/logs"
    60	PROFILE_ROOT_DIR="${PROFILE_ROOT_DIR:-${RUN_DIR}/profile}"
    61	PROFILE_DIRS="${PROFILE_DIRS:-${PROFILE_ROOT_DIR}}"
    62	SERVER_LOG="${LOG_DIR}/server.log"
    63	SERVER_PID_FILE="${RUN_DIR}/server.pid"
    64	SERVER_PID=""; CLEANED=0
    65	
    66	# ============ 测试用例矩阵(跟 vllmBench 一致,9 case)============
    67	# 模型:   Qwen3-32B-W8A8
    68	# 调度:   async
    69	# bs:     MAX_CONCURRENCY
    70	# input:  {128, 1024, 2048}
    71	# output: {128, 1024, 2048}
    72	CASES=(
    73	  "128 128"
    74	#   "128 1024"
    75	#   "128 2048"
    76	#   "1024 128"
    77	#   "1024 1024"
    78	#   "1024 2048"
    79	#   "2048 128"
    80	#   "2048 1024"
    81	#   "2048 2048"
    82	)
    83	# 可选 case 文件:每行一个 "input output",忽略空行与 # 注释
    84	if [[ -n "${CASES_FILE:-}" ]]; then
    85	    [[ -f "$CASES_FILE" ]] || { echo "ERROR: 找不到 CASES_FILE=$CASES_FILE" >&2; exit 2; }
    86	    mapfile -t CASES < <(grep -Ev '^[[:space:]]*(#|$)' "$CASES_FILE")
    87	fi
    88	
    89	# 子进程环境清理:只保留 CoreX 库路径配置,扔掉可能继承的旧 profiler/measurement
    90	# 注入变量(陈旧 VLLM_TORCH_PROFILER_DIR / LD_PRELOAD 会污染本次采集)。
    91	CLEAN_ENV=(env -u LD_PRELOAD -u LD_AUDIT -u LD_DEBUG -u LD_DEBUG_OUTPUT -u LD_BIND_NOT
    92	    -u LD_PROFILE -u VLLM_TORCH_PROFILER_DIR -u PROFILER_CONFIG -u TORCH_PROFILER_DIR)
    93	
    94	log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"; }
    95	
    96	# 是否 profile 某个 case(沿用接口名 should_profile_instance,实际传的是 case 索引;
    97	# PROFILE_EVERY 控制采样间隔)
    98	should_profile_instance() {
    99	    local idx="$1"
   100	    [ $((idx % PROFILE_EVERY)) -eq 0 ]
   101	}
   102	
   103	check_gpu_memory() {
   104	    local gpu free_mib
   105	    local -a gpus=()
   106	    IFS=',' read -r -a gpus <<< "$GPU_LIST"
   107	    if ! command -v ixsmi >/dev/null; then log 'WARNING: ixsmi 不可用，跳过显存预检'; return; fi
   108	    for gpu in "${gpus[@]}"; do
   109	        free_mib=$(ixsmi --query-gpu=memory.free --format=csv,noheader,nounits -i "$gpu" 2>/dev/null | tr -d ' ')
   110	        if [[ "$free_mib" =~ ^[0-9]+$ ]]; then
   111	            log "GPU $gpu: free=${free_mib} MiB"
   112	            (( free_mib >= 20480 )) || log "WARNING: GPU $gpu 显存偏低，请确认测试卡已预留"
   113	        else log "WARNING: 无法读取 GPU $gpu 显存"; fi
   114	    done
   115	    return 0
   116	}
   117	
   118	wait_for_server() {
   119	    local elapsed=0 code
   120	    while (( elapsed < 600 )); do
   121	        kill -0 "$SERVER_PID" 2>/dev/null || { log "ERROR: 服务已退出，查看 $SERVER_LOG"; return 1; }
   122	        code=$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' --max-time 2 "http://127.0.0.1:${PORT}/health" 2>/dev/null || true)
   123	        [[ "$code" == 200 ]] && { log "服务就绪 (${elapsed}s)"; return 0; }
   124	        sleep 5; elapsed=$((elapsed+5))
   125	    done
   126	    log 'ERROR: 服务启动超时'; return 1
   127	}
   128	
   129	start_server() {
   130	    # 拒绝端口被占用;绝不按名称/端口杀掉无关服务。
   131	    "${CLEAN_ENV[@]}" "$PYTHON_BIN" - "$PORT" <<'PY' || return 1
   132	import socket,sys
   133	with socket.socket() as s:s.bind(('127.0.0.1',int(sys.argv[1])))
   134	PY
   135	    if [[ -f "$SERVER_PID_FILE" ]]; then
   136	        log "检测到旧 server PID 文件，先停止旧进程"
   137	        stop_server
   138	    fi
   139	    check_gpu_memory "$GPU_LIST"
   140	
   141	    log "启动 vLLM 服务 | model=$MODEL_PATH | gpu=$GPU_LIST | port=$PORT | python=$PYTHON_BIN"
   142	    SERVER_PREFIX=()
   143	    if [ "$ENABLE_TASKSET_BINDING" = "1" ]; then
   144	        if [ -z "$CPU_RANGE" ]; then
   145	            log "ERROR: ENABLE_TASKSET_BINDING=1 时必须设置 CPU_RANGE"
   146	            return 1
   147	        fi
   148	        SERVER_PREFIX=(taskset -c "$CPU_RANGE")
   149	        log "taskset 绑定: ${SERVER_PREFIX[*]}"
   150	    fi
   151	
   152	    # vLLM 0.23+ 完全弃用 VLLM_TORCH_PROFILER_DIR 环境变量,改用 --profiler-config。
   153	    # 三个关键点:
   154	    #  1. torch_profiler_dir 必须是绝对路径(0.23 内部 os.path.abspath 以 server 进程 cwd 为基准,
   155	    #     相对路径可能解析不到 PROFILE_ROOT_DIR)
   156	    #  2. ignore_frontend=true 避免前端 profiling 把整个 trace 范围录下来导致文件巨大
   157	    #  3. warmup_iterations=0 时连续记录;模型 warmup 在 bench serve 中先执行
   158	    local profile_dir_abs
   159	    profile_dir_abs="$(cd "$(dirname "$PROFILE_DIRS")" 2>/dev/null && pwd)/$(basename "$PROFILE_DIRS")"
   160	
   161	    local profiler_config_json
   162	    profiler_config_json=$(cat <<EOF
   163	{"profiler":"torch","torch_profiler_dir":"${profile_dir_abs}","delay_iterations":${PROFILE_DELAY_ITERATIONS},"max_iterations":${PROFILE_MAX_ITERATIONS},"warmup_iterations":${PROFILE_WARMUP_ITERATIONS},"active_iterations":${PROFILE_ACTIVE_ITERATIONS},"ignore_frontend":true}
   164	EOF
   165	)
   166	    # 去掉 heredoc 引入的多余换行,确保是单行 JSON
   167	    profiler_config_json="$(echo "$profiler_config_json" | tr -d '\n')"
   168	
   169	    "${CLEAN_ENV[@]}" CUDA_VISIBLE_DEVICES="$GPU_LIST" \
   170	    VLLM_ENFORCE_CUDA_GRAPH=1 \
   171	    VLLM_USE_V1=1 \
   172	    VLLM_RPC_TIMEOUT="$VLLM_RPC_TIMEOUT" \
   173	    "${SERVER_PREFIX[@]}" "$PYTHON_BIN" -m vllm.entrypoints.openai.api_server \
   174	        --host 127.0.0.1 \
   175	        --port "$PORT" \
   176	        --model "$MODEL_PATH" \
   177	        --trust_remote_code \
   178	        --dtype auto \
   179	        --max_model_len 4096 \
   180	        --distributed_executor_backend mp \
   181	        --pipeline_parallel_size 1 \
   182	        --tensor_parallel_size "$GPUS_PER_INSTANCE" \
   183	        --data_parallel_size 1 \
   184	        --quantization compressed-tensors \
   185	        --gpu_memory_utilization 0.9 \
   186	        --kv_cache_dtype auto \
   187	        --enable_chunked_prefill \
   188	        --compilation-config '{"cudagraph_mode":"FULL_DECODE_ONLY", "mode":0}' \
   189	        --async-scheduling \
   190	        --profiler-config "$profiler_config_json" \
   191	        >> "$SERVER_LOG" 2>&1 &
   192	
   193	    SERVER_PID=$!
   194	    echo "$SERVER_PID" > "$SERVER_PID_FILE"
   195	    log "服务 PID=$SERVER_PID, 日志=$SERVER_LOG, profile 目录(绝对)=$profile_dir_abs"
   196	    log "profiler-config: $profiler_config_json"
   197	
   198	    wait_for_server
   199	
   200	    # 校验 profiler 是否真的生效:从 server.log 里 grep 关键字
   201	    #   - 'Profiler with mode' 来自 vllm/entrypoints/serve/profile/api_router.py
   202	    #     表示 /start_profile /stop_profile 端点已注册
   203	    #   - 'Torch profiling enabled' 来自 vllm/profiler/wrapper.py
   204	    #     表示 worker 端 TorchProfilerWrapper 已配置
   205	    # wait_for_server 之后 model_runner 已经初始化完毕,这两条 log 必然已写出
   206	    if grep -qE "Profiler with mode|Torch profiling enabled" "$SERVER_LOG" 2>/dev/null; then
   207	        log "✅ profiler 已生效(/start_profile /stop_profile 端点已注册,worker 端已配 TorchProfilerWrapper)"
   208	    else
   209	        log "❌ WARNING: server.log 里没找到 profiler 关键字"
   210	        log "   请确认启动参数包含 --profiler-config '...profiler\\\":\\\"torch\\\"...' "
   211	        log "   或在 server.log 里搜 'profiler' / 'profile' 看具体报错"
   212	    fi
   213	}
   214	
   215	stop_server() {
   216	    if [[ -f "$SERVER_PID_FILE" ]]; then
