+        log "等待 ${CASE_INTERVAL}s..."
+        sleep "$CASE_INTERVAL"
+    else
+        log "==== case $idx: 启动 server (PROFILE_DIRS=$PROFILE_DIRS) ===="
+    fi
+
+    if ! start_server; then
+        log "ERROR: case $idx 启动 server 失败"
+        FAILED_CASES+=("in${input_len}_out${output_len}")
+        continue
