+    # ===== on 模式:注入 sitecustomize + 插件 env + 绑核方式 =====
+    # 绑核方式由 AFFINITY_MODE 控制:
+    #   AFFINITY_MODE=plugin (默认) -> 插件 generic 链真正绑核。
+    #       秘钥: ① 必须保留原生 --numa-bind(否则插件 should_resolve() 因
+    #         numa_bind=False 直接返回,完全不动作,见 vllm_lifecycle.py:25)
+    #       ② 必须设 KUNPENG_AFFINITY_VLLM_FORCE_GENERIC=1(否则 auto 下
+    #         插件走 native 优先 → 返回 source=native,插件仍不参与)。
+    #       两者都满足才出现 'selected NUMA nodes=... source=generic'。
+    #   AFFINITY_MODE=native -> 原生 --numa-bind(auto),native 优先,插件 defer。
+    #       对应旧 on1 行为(日志出 Auto-detected NUMA nodes,非插件绑核)。
+    AFFINITY_MODE="${AFFINITY_MODE:-plugin}"
+    local bootstrap_dir="${RUN_DIR}/bootstrap"
+    mkdir -p "$bootstrap_dir"
+    if [ ! -f "$bootstrap_dir/sitecustomize.py" ]; then
+        cat > "$bootstrap_dir/sitecustomize.py" <<'PY'
+from kunpeng_affinity.vllm_plugin import register
+register()
+PY
+    fi
+
+    export PYTHONPATH="${bootstrap_dir}:${REPO_ROOT}/src"
+    export KUNPENG_AFFINITY_MODE=auto
+    export KUNPENG_AFFINITY_PROVIDER=iluvatar-runtime-pci
+    export KUNPENG_AFFINITY_IXSMI="$IXSMI_BIN"
+    # 关键: KUNPENG_AFFINITY_VLLM_FORCE_GENERIC 控制插件是否绕过 native。
+    #   =1  -> 强制插件 generic 链(真插件绑核,source=generic)
+    #   unset-> auto: native 优先,插件 defer(旧 on1 行为,非插件绑核)
+    if [ "$AFFINITY_MODE" = "plugin" ]; then
+        export KUNPENG_AFFINITY_VLLM_FORCE_GENERIC=1
+    else
+        unset KUNPENG_AFFINITY_VLLM_FORCE_GENERIC
+    fi
+
+    # 两种模式都用 --numa-bind 激活 should_resolve;
+    # plugin/native 的真正差异由上面 KUNPENG_AFFINITY_VLLM_FORCE_GENERIC 控制
+    AFFINITY_EXTRA=(--numa-bind)
+    if [ "$AFFINITY_MODE" = "plugin" ]; then
+        log "绑核方式: 插件 generic 绑核 (AFFINITY_MODE=plugin, --numa-bind + FORCE_GENERIC=1)"
+    else
+        log "绑核方式: vLLM 原生 --numa-bind (AFFINITY_MODE=native, 插件将 defer)"
