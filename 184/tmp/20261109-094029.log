+# ---- PGO guard: autofix two known-safe block causes, verify rollback --------
+PGO_VENV=/opt/corex311
+PGO_STATE=/root/.local/state/cpython-vllm-rebase
+
+pgo_runtime() {
+    "${CLEAN_ENV[@]}" -u PYTHONPATH -u PYTHONHOME "$PYTHON_BIN" -c \
+        'import sysconfig; print(sysconfig.get_config_var("CONFIG_ARGS") or "")' 2>/dev/null || true
+}
+
+pgo_is_on() {
+    local args
+    args=$(pgo_runtime)
+    [[ "$args" == *"--prefix=/opt/cpython-vllm/v1"* && "$args" == *"--with-lto"* ]]
+}
+
+pgo_fix_perms() {
+    local dir mode
+    for dir in "$PGO_VENV" "$PGO_VENV/bin" "$PGO_VENV/lib" "$PGO_VENV/lib/python3.11" \
+               "$PGO_VENV/lib/python3.11/site-packages"; do
+        [[ -d "$dir" ]] || continue
+        mode=$(stat -c %a "$dir" 2>/dev/null) || continue
+        if (( (8#$mode & 8#022) != 0 )); then
+            chmod g-w,o-w "$dir" && log "autofix: chmod g-w,o-w $dir"
+        fi
+    done
+}
+
+pgo_fix_index() {
+    local idx
+    idx=$(ls -1 "$PGO_STATE"/venv-*.json 2>/dev/null | head -1)
+    [[ -n "$idx" ]] || { log "autofix: 未找到索引文件，跳过"; return 1; }
+    mv -- "$idx" "$idx.stale-$(date +%Y%m%d_%H%M%S)" \
+        && log "autofix: 旧索引已挪开 -> $(basename "$idx").stale-*"
+}
+
+# Switch back to PGO; retries once after a known-safe autofix.
+pgo_switch() {
+    local out rc
+    out=$(env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
+        cpython-vllm-rebase switch --venv "$PGO_VENV" --ack-services-stopped 2>&1); rc=$?
+    if (( rc == 0 )); then
+        printf '%s\n' "$out"
+        return 0
+    fi
+    log "rebase switch 失败: $(printf '%s' "$out" | tr '\n' ' ' | tail -c 220)"
+    case "$out" in
+        *VENV_DIRECTORY_GROUP_OR_WORLD_WRITABLE*)
+            log "autofix: venv 目录带组/其他用户写权限，修正后重试"
+            pgo_fix_perms ;;
+        *PACKAGE_METADATA_CHANGED*)
+            log "autofix: 包清单与旧事务记录不一致，挪开索引后重试"
+            pgo_fix_index || return "$rc" ;;
+        *)
+            return "$rc" ;;
+    esac
+    env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
+        cpython-vllm-rebase switch --venv "$PGO_VENV" --ack-services-stopped
+}
+
+# Rollback; if the index record is gone, fall back to the newest APPLIED
+# transaction (this is the NO_MANAGED_TRANSACTION_... case).
+pgo_rollback() {
+    local out rc txn
+    out=$(env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
+        cpython-vllm-rebase rollback --venv "$PGO_VENV" --ack-services-stopped 2>&1); rc=$?
+    if (( rc == 0 )); then
+        printf '%s\n' "$out"
+        return 0
+    fi
+    log "rebase rollback 失败: $(printf '%s' "$out" | tr '\n' ' ' | tail -c 220)"
+    if [[ "$out" == *NO_MANAGED_TRANSACTION* ]]; then
+        txn=$(grep -l '"APPLIED_VERIFIED"' "$PGO_STATE"/20*/state.json 2>/dev/null \
+              | sed 's|/state.json$||' | sort | tail -1)
+        if [[ -n "$txn" ]]; then
+            log "autofix: 索引缺失，改用 --transaction $(basename "$txn")"
+            env -u LD_PRELOAD -u PYTHONPATH -u PYTHONHOME \
+                cpython-vllm-rebase rollback --transaction "$txn" --ack-services-stopped
+            return $?
+        fi
+        log "autofix: 未找到可回滚的 APPLIED 事务"
+    fi
+    return "$rc"
+}
