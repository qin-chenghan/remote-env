#!/usr/bin/env bash
# Resolve vendor and ordinary requirements together in a fresh, isolated venv.
set -Eeuo pipefail

bundle_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
python_command="${1:-python3.11}"
venv_prefix="${2:-/opt/corex-vllm-py311}"

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

[[ "$(uname -s)" == Linux && "$(uname -m)" == aarch64 ]] || die 'Requires Linux AArch64.'
base_python="$(command -v -- "$python_command")" || die "Installed interpreter not found: $python_command"
[[ -x "$base_python" ]] || die "Interpreter is not executable: $base_python"
unset PYTHONHOME PYTHONPATH
python_prefix="$("$base_python" -c 'import sys; print(sys.prefix)')"
[[ "$venv_prefix" == /* && "$venv_prefix" != / && "$venv_prefix" != /usr && "$venv_prefix" != /usr/local && "$venv_prefix" != "$python_prefix" ]] || die 'Use a new absolute venv prefix.'
[[ "$venv_prefix" != *[[:space:]]* ]] || die 'The venv prefix must not contain whitespace.'
[[ ! -e "$venv_prefix" ]] || die "Venv already exists: $venv_prefix; use a new directory instead of overwriting it."
command -v sha256sum >/dev/null || die 'Missing verification tool: sha256sum'
[[ -s "$bundle_dir/SHA256SUMS.txt" ]] || die 'Missing SHA256SUMS.txt in the bundle root.'
(cd "$bundle_dir" && sha256sum --check --strict SHA256SUMS.txt)
for required_file in requirements-vendor-py311.txt requirements-py311.txt verify_corex311.py; do
  [[ -s "$bundle_dir/$required_file" ]] || die "Missing bundle file: $required_file"
done
shopt -s nullglob
vendor_wheels=("$bundle_dir/vendor/"*.whl)
[[ ${#vendor_wheels[@]} -gt 0 ]] || die 'No vendor wheels found.'

unset PYTHONHOME PYTHONPATH
export PIP_DISABLE_PIP_VERSION_CHECK=1
"$base_python" "$bundle_dir/verify_corex311.py" --runtime-only --expected-prefix "$python_prefix"
"$base_python" -m venv "$venv_prefix"
venv_python="$venv_prefix/bin/python"

# Exact CoreX pins participate in this same solve, preventing a transitive
# dependency from replacing the vendor Torch/Triton packages.
"$venv_python" -m pip install \
  --only-binary=:all: \
  --find-links "$bundle_dir/vendor" --find-links "$bundle_dir/wheels" \
  --requirement "$bundle_dir/requirements-vendor-py311.txt" \
  --requirement "$bundle_dir/requirements-py311.txt"
"$venv_python" -m pip --isolated check
"$venv_python" "$bundle_dir/verify_corex311.py" \
  --expected-prefix "$venv_prefix" --bundle "$bundle_dir" \
  --output "$venv_prefix/corex311-cpu-verification.json"
printf 'Package imports and CPU smoke passed. Evidence: %s\n' "$venv_prefix/corex311-cpu-verification.json"
printf 'For a device smoke, run: %q %q --expected-prefix %q --device cuda:0\n' \
  "$venv_python" "$bundle_dir/verify_corex311.py" "$venv_prefix"
